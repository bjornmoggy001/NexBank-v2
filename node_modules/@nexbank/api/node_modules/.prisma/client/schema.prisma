generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  SUPPORT
  ADMIN
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum AccountType {
  TREASURY
  CHECKING
  SAVINGS
}

enum Currency {
  KES
  USD
  EUR
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum TransferStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerEntryType {
  TRANSFER_P2P
  DEPOSIT
  WITHDRAWAL
  BILL_PAYMENT
  CARD_PURCHASE
  CARD_REFUND
  FEE
  ADJUSTMENT
}

enum CardType {
  VIRTUAL
  PHYSICAL
}

enum CardStatus {
  ACTIVE
  FROZEN
  CANCELLED
}

enum CardTxnStatus {
  APPROVED
  DECLINED
}

enum BillPaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

// User model
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole @default(USER)

  // KYC (Know Your Customer) — regulatory identity verification
  kycStatus        KycStatus @default(UNVERIFIED)
  kycSubmittedAt   DateTime?
  kycVerifiedAt    DateTime?
  dateOfBirth      DateTime?
  nationalIdNumber String?
  country          String?   @default("KE")

  // Account security state
  isActive     Boolean @default(true)
  isFrozen     Boolean @default(false)
  frozenReason String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Relations (no columns generated — these are Prisma-side joins)
  accounts          Account[]
  cards             Card[]
  sentTransfers     Transfer[]     @relation("SentTransfers")
  receivedTransfers Transfer[]     @relation("ReceivedTransfers")
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  billPayments      BillPayment[]

  @@index([email])
  @@index([kycStatus])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?

  @@index([userId])
}

model Account {
  id            String        @id @default(uuid())
  accountNumber String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          AccountType
  currency      Currency      @default(KES)
  status        AccountStatus @default(ACTIVE)
  nickname      String?
  isDefault     Boolean       @default(false)

  // Read-optimized cache. SOURCE OF TRUTH is ledger entries. Never trust
  // this value in financial-critical paths without option to recompute.
  balanceCache BigInt @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries     LedgerEntry[]
  cards             Card[]
  sentTransfers     Transfer[]    @relation("FromAccount")
  receivedTransfers Transfer[]    @relation("ToAccount")
  billPayments      BillPayment[]

  @@index([userId])
  @@index([accountNumber])
}

model LedgerTransaction {
  id          String          @id @default(uuid())
  type        LedgerEntryType
  description String
  reference   String          @unique
  metadata    Json?
  createdAt   DateTime        @default(now())

  entries     LedgerEntry[]
  transfer    Transfer?
  billPayment BillPayment?
  cardTxn     CardTransaction?
}

model LedgerEntry {
  id           String            @id @default(uuid())
  ledgerTxnId  String
  ledgerTxn    LedgerTransaction @relation(fields: [ledgerTxnId], references: [id], onDelete: Restrict)
  accountId    String
  account      Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  direction    LedgerDirection
  amount       BigInt
  currency     Currency
  balanceAfter BigInt
  createdAt    DateTime          @default(now())

  @@index([accountId, createdAt])
  @@index([ledgerTxnId])
}

model Transfer {
  id            String            @id @default(uuid())
  ledgerTxnId   String            @unique
  ledgerTxn     LedgerTransaction @relation(fields: [ledgerTxnId], references: [id])
  fromAccountId String
  fromAccount   Account           @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccountId   String
  toAccount     Account           @relation("ToAccount", fields: [toAccountId], references: [id])
  senderId      String
  sender        User              @relation("SentTransfers", fields: [senderId], references: [id])
  recipientId   String
  recipient     User              @relation("ReceivedTransfers", fields: [recipientId], references: [id])
  amount        BigInt
  currency      Currency
  note          String?
  status        TransferStatus    @default(COMPLETED)
  createdAt     DateTime          @default(now())

  @@index([senderId])
  @@index([recipientId])
}

model Card {
  id                   String     @id @default(uuid())
  userId               String
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId            String
  account              Account    @relation(fields: [accountId], references: [id])
  type                 CardType   @default(VIRTUAL)
  status               CardStatus @default(ACTIVE)
  panLast4             String
  panMasked            String
  expiryMonth          Int
  expiryYear           Int
  cvvHash              String
  spendingLimitMonthly BigInt?
  label                String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  transactions CardTransaction[]

  @@index([userId])
}

model CardTransaction {
  id               String             @id @default(uuid())
  ledgerTxnId      String?            @unique
  ledgerTxn        LedgerTransaction? @relation(fields: [ledgerTxnId], references: [id])
  cardId           String
  card             Card               @relation(fields: [cardId], references: [id])
  merchantName     String
  merchantCategory String?
  amount           BigInt
  currency         Currency
  status           CardTxnStatus
  declineReason    String?
  createdAt        DateTime           @default(now())

  @@index([cardId, createdAt])
}

model Biller {
  id       String  @id @default(uuid())
  name     String
  category String
  logoUrl  String?
  isActive Boolean @default(true)

  payments BillPayment[]
}

model BillPayment {
  id               String             @id @default(uuid())
  ledgerTxnId      String?            @unique
  ledgerTxn        LedgerTransaction? @relation(fields: [ledgerTxnId], references: [id])
  userId           String
  user             User               @relation(fields: [userId], references: [id])
  accountId        String
  account          Account            @relation(fields: [accountId], references: [id])
  billerId         String
  biller           Biller             @relation(fields: [billerId], references: [id])
  amount           BigInt
  currency         Currency
  status           BillPaymentStatus  @default(COMPLETED)
  accountRefNumber String?
  createdAt        DateTime           @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  targetId  String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
}
